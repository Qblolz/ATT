<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
	<Button name="ATTButtonTemplateClassic" hidden="true" virtual="true">
		<Animations>
			<AnimationGroup parentKey="newitemglowAnim" setToFinalAlpha="true">
				<Alpha childKey="NewItemTexture" smoothing="OUT" duration="1.5" order="1" fromAlpha="1" toAlpha="0" />
			</AnimationGroup>
			<AnimationGroup parentKey="flashAnim" setToFinalAlpha="true">
				<Alpha childKey="flash" smoothing="OUT" duration="1.2" order="1" fromAlpha="1" toAlpha="0" />
			</AnimationGroup>
		</Animations>
		<Layers>
			<Layer level="OVERLAY">
				<Texture parentKey="flash" alpha="0" alphaMode="ADD" file="Interface\SpellActivationOverlay\IconAlert">
					<Size>
						<AbsDimension x="76" y="76"/>
					</Size>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
					<TexCoords left="0.00781250" right="0.50781250" top="0.27734375" bottom="0.52734375"/>
				</Texture>
				<Texture parentKey="NewItemTexture" alpha="0" alphaMode="ADD" file="Interface\SpellActivationOverlay\IconAlertAnts">
					<Size>
						<AbsDimension x="60" y="60"/>
					</Size>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
	</Button>

	<Button name="ATTButtonTemplate" inherits="ActionButtonTemplate" hidden="true" virtual="true">
		<Animations>
			<AnimationGroup parentKey="newitemglowAnim" setToFinalAlpha="true">
				<Alpha childKey="NewItemTexture" smoothing="OUT" duration="1.5" order="1" fromAlpha="1" toAlpha="0" />

			</AnimationGroup>
			<AnimationGroup parentKey="flashAnim" setToFinalAlpha="true">
				<Alpha childKey="flash" smoothing="OUT" duration="1.2" order="1" fromAlpha="1" toAlpha="0" />
			</AnimationGroup>
		</Animations>
		<Layers>
			<Layer level="OVERLAY" >
				<Texture parentKey="flash" hidden="false" alpha="0" alphaMode="ADD" file="Interface\SpellActivationOverlay\IconAlert">
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
				<Texture parentKey="NewItemTexture" alpha="0" hidden="false" alphaMode="ADD" file="Interface\SpellActivationOverlay\IconAlertAnts">
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
	</Button>
</Ui>
